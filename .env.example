# ODK Search Configuration

# SearXNG - Açık kaynak meta search engine (ÖNERİLEN)
# Hiçbir şey ayarlamazsan varsayılan https://searx.be kullanılır.
# API key gerekmez. Değiştirmek istersen:
# ODK_SEARXNG_URL=https://searx.be

# Google Custom Search API (2025'ten beri yeni kayıt kapalı)
# ODK_GOOGLE_KEY=AIza...
# ODK_GOOGLE_CX=...

# Bing Search API (Azure - ücretli)
# ODK_BING_KEY=...

# Shodan API (IoT search - ücretli)
# ODK_SHODAN_KEY=...
